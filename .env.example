# Copy to .env.local for local development (never commit the real file).
# Required — from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — must be an address on a domain verified in Resend.
# Defaults to onboarding@resend.dev (Resend's shared test sender) if unset.
CONTACT_FROM_EMAIL="Skyway Cleaning <quotes@skywaycleaning.com.au>"
